# Skopiuj do .env i UZUPELNIJ SEKRETY (nie commituj .env!)
# Sekrety produkcyjne trzymaj w menedzerze sekretow (Vault / AWS Secrets / Doppler).

COMPOSE_PROJECT_NAME=airalert-monitor
POSTGRES_PASSWORD=change-me-strong-password

# Backend
AIRALERT_ENVIRONMENT=local
AIRALERT_DATABASE_URL=sqlite:///./airalert.db   # w docker-compose nadpisywane na Postgres
AIRALERT_ADMIN_API_TOKEN=                       # pusty => panel administracyjny zablokowany
AIRALERT_STRICT_DOMAIN_PIN=true
AIRALERT_STALE_AFTER_MINUTES=60

# Powiadomienia
AIRALERT_NOTIFICATION_MERGE_WINDOW_S=300
AIRALERT_NOTIFICATION_MAX_PER_HOUR_PER_SUBSCRIPTION=10
AIRALERT_LOUD_ALERTS_OFFICIAL_ONLY=true
AIRALERT_FCM_SERVER_KEY=
# Sekret szyfrowania tokenow push - OBOWIAZKOWO nadpisz w produkcji!
AIRALERT_PUSH_TOKEN_SECRET=change-me-dev-only
